{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"paths": {
			"@deepseek-ai/cordis": ["./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
			"@deepseek-ai/cordis/*": ["./node_modules/@deepseek-ai/cordis/lib/types/*"],
			"@deepseek-ai/schemastery": ["./node_modules/@deepseek-ai/schemastery/lib/index.d.ts"],
			"@deepseek-ai/dsh-storage-domain": ["./node_modules/@deepseek-ai/dsh-storage-domain/lib/types/index.d.ts"],
			"@deepseek-ai/dsh-client-connection": ["./node_modules/@deepseek-ai/dsh-client-connection/lib/types/index.d.ts"],
			"@deepseek-ai/dsh-client-connection/client": ["./node_modules/@deepseek-ai/dsh-client-connection/lib/types/client/index.d.ts"],
			"@deepseek-ai/dsh-client-connection/types": ["./node_modules/@deepseek-ai/dsh-client-connection/lib/types/types.d.ts"],
			"@deepseek-ai/dsh-session/types": ["./node_modules/@deepseek-ai/dsh-session/lib/types/types.d.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "scripts/**/*.mjs"]
}
